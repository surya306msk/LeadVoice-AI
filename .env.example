# LeadVoice AI - Environment Configuration Template

# Application & Server Config
PORT=8000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000

# Development / Mock Mode Settings
MOCK_MODE=true
VOICE_PROVIDER=mock
MESSAGING_PROVIDER=mock

# Database Configuration
DATABASE_URL=sqlite:///./leadvoice.db

# LLM Service (Groq API)
GROQ_API_KEY=

# Voice Telephony Provider (Retell AI)
RETELL_API_KEY=
RETELL_AGENT_ID=

# Messaging Provider - Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Messaging Provider - WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_RECIPIENT_PHONE=

# File Attachments (Optional)
RESUME_FILE_PATH=
ARCHITECTURE_IMAGE_PATH=
